# =====================================================================
#  Fichier d'exemple — copier en `.env` (jamais versionné) puis adapter.
#  Toutes les valeurs ci-dessous sont FICTIVES.
# =====================================================================

# --- Neo4j ---------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-strong-password
NEO4J_DATABASE=neo4j

# --- LLM -----------------------------------------------------------------
# LLM_PROVIDER : offline | openai_compatible | anthropic
#   offline            : aucun appel externe (générateur extractif + extraction par règles)
#   openai_compatible  : toute API qui implémente POST {LLM_BASE_URL}/chat/completions
#                        (OpenAI, Mistral, Groq, DeepSeek, OpenRouter, vLLM, Ollama…)
#   anthropic          : API Messages d'Anthropic (POST {LLM_BASE_URL}/v1/messages)
LLM_PROVIDER=offline
LLM_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.example.com/v1
LLM_MODEL=model-name
LLM_TIMEOUT_SECONDS=60
LLM_MAX_TOKENS=1200
LLM_TEMPERATURE=0
# Anthropic uniquement : profondeur de raisonnement (low | medium | high | xhigh | max) et repli
# côté serveur vers un modèle de secours en cas de refus (true par défaut).
LLM_EFFORT=medium
LLM_ANTHROPIC_FALLBACKS=true
# Utiliser le LLM pour l'extraction de connaissances à l'ingestion (en plus des règles)
LLM_EXTRACTION_ENABLED=false

# --- Embeddings ------------------------------------------------------------
# EMBEDDING_PROVIDER : wordllama (défaut, retenu après ablation) | spacy (vecteurs de mots moyennés)
# Changer d'encodeur impose de réingérer le corpus (dimension de l'index vectoriel différente).
EMBEDDING_PROVIDER=wordllama

# --- Recherche ---------------------------------------------------------------
# Premiers résultats de chaque source garantis dans le contexte (0 = fusion RRF pure)
RETRIEVAL_SOURCE_GUARANTEE=1

# --- Sécurité de l'API --------------------------------------------------------
# Clé de signature des jetons (générer : python -c "import secrets; print(secrets.token_urlsafe(48))")
APP_SECRET_KEY=replace-with-a-long-random-string
TOKEN_TTL_MINUTES=480
# Fichier des utilisateurs (mots de passe hachés). Voir RAG/CODE/config/users.example.yaml
USERS_FILE=config/users.example.yaml
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Ingestion -------------------------------------------------------------
DOCUMENTS_DIR=../data/sample_documents
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=200
OCR_LANGUAGES=fra+eng

# --- Divers -------------------------------------------------------------------
LOG_LEVEL=INFO
# Date de référence pour la fraîcheur des preuves (reproductibilité des évaluations)
REFERENCE_DATE=2026-10-01

# --- Docker Compose -------------------------------------------------------------
# Adresse et port de publication de l'interface (127.0.0.1 = accessible depuis la machine seulement ;
# derrière un reverse proxy TLS, garder 127.0.0.1).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
# Images de base (remplaçables par un miroir interne)
# UBUNTU_IMAGE=ubuntu:24.04
# NEO4J_IMAGE=neo4j:5.26-community
